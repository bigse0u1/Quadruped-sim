<mujoco model="spot integrated task (map + traffic + grasp)">
  <!-- 친구(taekyeong)의 맵을 그대로 사용: scene_map.xml 을 직접 include.
       (맵 구조가 바뀌면 자동 반영됨) 여기서는 파지용 물건 6개 + weld 만 추가. -->
  <include file="../_taekyeong/scene_map.xml"/>

  <asset>
    <!-- 물건 색상 -->
    <material name="m_apple"  rgba="0.90 0.12 0.12 1"/>
    <material name="m_banana" rgba="0.95 0.85 0.10 1"/>
    <material name="m_orange" rgba="0.95 0.55 0.10 1"/>
    <material name="m_grape"  rgba="0.55 0.20 0.75 1"/>
    <material name="m_lemon"  rgba="0.85 0.95 0.20 1"/>
    <material name="m_tomato" rgba="0.85 0.10 0.05 1"/>
  </asset>

  <worldbody>
    <!-- =========================================================
         물건 6개 (초록 플랫폼 가장자리, z=0.24 = 윗면 0.20 + 반치수 0.04)
         이름이 프롬프트 매칭 키. free joint 로 파지·운반.
         좌표는 main_task.py OBJECTS 와 일치시킬 것.
         ========================================================= -->
    <!-- green_01 (-22,23): 사과, 바나나 (남쪽 가장자리) -->
    <body name="obj_apple" pos="-22.7 22.05 0.24">
      <freejoint name="apple_free"/>
      <inertial pos="0 0 0" mass="0.2" diaginertia="2e-4 2e-4 2e-4"/>
      <geom name="apple_geom" type="box" size="0.04 0.04 0.04" material="m_apple"
            friction="1.2 0.05 0.001" condim="6" priority="2" solimp="0.95 0.99 0.001"/>
    </body>
    <body name="obj_banana" pos="-21.3 22.05 0.24">
      <freejoint name="banana_free"/>
      <inertial pos="0 0 0" mass="0.2" diaginertia="2e-4 2e-4 2e-4"/>
      <geom name="banana_geom" type="box" size="0.04 0.04 0.04" material="m_banana"
            friction="1.2 0.05 0.001" condim="6" priority="2" solimp="0.95 0.99 0.001"/>
    </body>

    <!-- green_02 (14,13): 오렌지, 포도 (서쪽 가장자리) -->
    <body name="obj_orange" pos="13.05 12.3 0.24">
      <freejoint name="orange_free"/>
      <inertial pos="0 0 0" mass="0.2" diaginertia="2e-4 2e-4 2e-4"/>
      <geom name="orange_geom" type="box" size="0.04 0.04 0.04" material="m_orange"
            friction="1.2 0.05 0.001" condim="6" priority="2" solimp="0.95 0.99 0.001"/>
    </body>
    <body name="obj_grape" pos="13.05 13.7 0.24">
      <freejoint name="grape_free"/>
      <inertial pos="0 0 0" mass="0.2" diaginertia="2e-4 2e-4 2e-4"/>
      <geom name="grape_geom" type="box" size="0.04 0.04 0.04" material="m_grape"
            friction="1.2 0.05 0.001" condim="6" priority="2" solimp="0.95 0.99 0.001"/>
    </body>

    <!-- green_03 (-11,-2): 레몬, 토마토 (남쪽 가장자리) -->
    <body name="obj_lemon" pos="-11.4 -3.95 0.24">
      <freejoint name="lemon_free"/>
      <inertial pos="0 0 0" mass="0.2" diaginertia="2e-4 2e-4 2e-4"/>
      <geom name="lemon_geom" type="box" size="0.04 0.04 0.04" material="m_lemon"
            friction="1.2 0.05 0.001" condim="6" priority="2" solimp="0.95 0.99 0.001"/>
    </body>
    <body name="obj_tomato" pos="-10.6 -3.95 0.24">
      <freejoint name="tomato_free"/>
      <inertial pos="0 0 0" mass="0.2" diaginertia="2e-4 2e-4 2e-4"/>
      <geom name="tomato_geom" type="box" size="0.04 0.04 0.04" material="m_tomato"
            friction="1.2 0.05 0.001" condim="6" priority="2" solimp="0.95 0.99 0.001"/>
    </body>
  </worldbody>

  <!-- 파지용 weld: 그리퍼(arm_link_fngr)와 각 물건. 평소 비활성, 잡을 때 활성화 -->
  <equality>
    <weld name="grab_apple"  body1="arm_link_fngr" body2="obj_apple"  active="false" solref="0.02 1" solimp="0.9 0.95 0.001"/>
    <weld name="grab_banana" body1="arm_link_fngr" body2="obj_banana" active="false" solref="0.02 1" solimp="0.9 0.95 0.001"/>
    <weld name="grab_orange" body1="arm_link_fngr" body2="obj_orange" active="false" solref="0.02 1" solimp="0.9 0.95 0.001"/>
    <weld name="grab_grape"  body1="arm_link_fngr" body2="obj_grape"  active="false" solref="0.02 1" solimp="0.9 0.95 0.001"/>
    <weld name="grab_lemon"  body1="arm_link_fngr" body2="obj_lemon"  active="false" solref="0.02 1" solimp="0.9 0.95 0.001"/>
    <weld name="grab_tomato" body1="arm_link_fngr" body2="obj_tomato" active="false" solref="0.02 1" solimp="0.9 0.95 0.001"/>
  </equality>
</mujoco>
