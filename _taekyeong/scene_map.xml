<mujoco model="spot 50x50 road map">
  <include file="../robots/boston_dynamics_spot/spot_arm.xml"/>

  <compiler meshdir="../robots/boston_dynamics_spot/assets"/>
  <option timestep="0.005" gravity="0 0 -9.81"/>

  <statistic center="0 0 0.5" extent="30" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.4 0.4 0.4" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="220" elevation="-20"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <!-- 하늘 -->
    <texture type="skybox" builtin="gradient"
             rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>

    <!-- 바닥 -->
    <texture name="grid" type="2d" builtin="checker"
             width="512" height="512"
             rgb1="1 1 1" rgb2="0.88 0.88 0.88"/>
    <material name="white_floor" texture="grid" texrepeat="1 1" texuniform="true"/>

    <!-- 재질 -->
    <material name="wall" rgba="0.75 0.75 0.70 1"/>
    <material name="building" rgba="0.72 0.72 0.72 1"/>
    <material name="green_area" rgba="0.40 0.65 0.24 1"/>
    <material name="red_mark" rgba="1 0.15 0.05 1"/>

    <!-- 도로 / 횡단보도 -->
    <material name="road" rgba="0.28 0.28 0.30 1"/>
    <material name="lane_mark" rgba="0.95 0.90 0.20 1"/>
    <material name="crosswalk" rgba="0.98 0.98 0.98 1"/>

    <!-- 신호등 -->
    <material name="pole" rgba="0.15 0.15 0.15 1"/>
    <material name="light_red" rgba="1 0 0 1"/>
    <material name="light_green" rgba="0 1 0 0.25"/>

    <!-- 자동차 -->
    <material name="car_red" rgba="0.85 0.18 0.18 1"/>
    <material name="car_blue" rgba="0.18 0.35 0.85 1"/>
    <material name="car_gray" rgba="0.4 0.4 0.4 1"/>
  </asset>

  <worldbody>
    <!-- 기본 바닥 -->
    <geom name="floor" type="box" size="25 25 0.025" pos="0 0 -0.025" material="white_floor"/>

    <!-- 외곽 벽 -->
    <geom name="wall_y_pos" type="box" size="25 0.1 0.75" pos="0 25 0.75" material="wall"/>
    <geom name="wall_y_neg" type="box" size="25 0.1 0.75" pos="0 -25 0.75" material="wall"/>
    <geom name="wall_x_pos" type="box" size="0.1 25 0.75" pos="25 0 0.75" material="wall"/>
    <geom name="wall_x_neg" type="box" size="0.1 25 0.75" pos="-25 0 0.75" material="wall"/>

    <!-- =========================
         건물 (기존 느낌 유지)
         ========================= -->
    <geom name="building_01" type="box" size="4.5 2.5 3.5" pos="-17.5 15.5 3.5" material="building"/>
    <geom name="building_02" type="box" size="2.5 5.5 3.5" pos="-6.5 18.5 3.5" material="building"/>
    <geom name="building_03a" type="box" size="5.5 3 3.5" pos="16.5 21 3.5" material="building"/>
    <geom name="building_03b" type="box" size="2.5 4.5 3.5" pos="19.5 14.5 3.5" material="building"/>

    <geom name="building_04a" type="box" size="3.5 6.5 3.5" pos="-18.5 -3.5 3.5" material="building"/>
    <geom name="building_04b" type="box" size="2 1.5 3.5" pos="-13.0 -9.5 3.5" material="building"/>
    <geom name="building_05" type="box" size="5 3 3.5" pos="0 -7 3.5" material="building"/>
    <geom name="building_06b" type="box" size="4 2 3.5" pos="12 -2 3.5" material="building"/>
    <geom name="building_07" type="box" size="2.5 4.5 3.5" pos="-6.5 -16.5 3.5" material="building"/>

    <!-- =========================
         초록 목적지
         ========================= -->
    <geom name="green_01" type="box" size="2 1 0.10" pos="-22 23 0.10" material="green_area"/>
    <geom name="green_02" type="box" size="1 2 0.10" pos="14 13 0.10" material="green_area"/>
    <geom name="green_03" type="box" size="1 2 0.10" pos="-11 -2 0.10" material="green_area"/>

    <!-- 빨간 마커 -->
    <geom name="red_mark_01" type="box" size="1 1 0.03" pos="0 23 0.03" material="red_mark" contype="0" conaffinity="0"/>
    <geom name="red_mark_02" type="box" size="1 1 0.03" pos="0 -19 0.03" material="red_mark" contype="0" conaffinity="0"/>

    <!-- =========================
         도로 (기존 물 대신)
         y = 5 부근 가로 도로
         ========================= -->
    <geom name="road_main_left"   type="box" size="10 2.5 0.01" pos="-15 5 0.01" material="road" contype="0" conaffinity="0"/>
    <geom name="road_main_mid"    type="box" size="8 2.5 0.01"  pos="0 5 0.01"   material="road" contype="0" conaffinity="0"/>
    <geom name="road_main_right"  type="box" size="10 2.5 0.01" pos="15 5 0.01"  material="road" contype="0" conaffinity="0"/>

    <!-- 중앙선 -->
    <geom name="lane_mark_01" type="box" size="4 0.08 0.012" pos="-20 5 0.012" material="lane_mark" contype="0" conaffinity="0"/>
    <geom name="lane_mark_02" type="box" size="4 0.08 0.012" pos="-10 5 0.012" material="lane_mark" contype="0" conaffinity="0"/>
    <geom name="lane_mark_03" type="box" size="4 0.08 0.012" pos="0 5 0.012" material="lane_mark" contype="0" conaffinity="0"/>
    <geom name="lane_mark_04" type="box" size="4 0.08 0.012" pos="10 5 0.012" material="lane_mark" contype="0" conaffinity="0"/>
    <geom name="lane_mark_05" type="box" size="4 0.08 0.012" pos="20 5 0.012" material="lane_mark" contype="0" conaffinity="0"/>

    <!-- =========================
         횡단보도 3개
         ========================= -->

    <!-- crosswalk 1 : x = -15 (차량용) -->
    <geom name="crosswalk1_s1" type="box" size="1.2 0.18 0.013" pos="-15 3.3 0.013" material="crosswalk" contype="0" conaffinity="0"/>
    <geom name="crosswalk1_s2" type="box" size="1.2 0.18 0.013" pos="-15 4.1 0.013" material="crosswalk" contype="0" conaffinity="0"/>
    <geom name="crosswalk1_s3" type="box" size="1.2 0.18 0.013" pos="-15 4.9 0.013" material="crosswalk" contype="0" conaffinity="0"/>
    <geom name="crosswalk1_s4" type="box" size="1.2 0.18 0.013" pos="-15 5.7 0.013" material="crosswalk" contype="0" conaffinity="0"/>
    <geom name="crosswalk1_s5" type="box" size="1.2 0.18 0.013" pos="-15 6.5 0.013" material="crosswalk" contype="0" conaffinity="0"/>

    <!-- crosswalk 2 : x = 0 (로봇 전용) -->
    <geom name="crosswalk2_s1" type="box" size="1.2 0.18 0.013" pos="0 3.3 0.013" material="crosswalk" contype="0" conaffinity="0"/>
    <geom name="crosswalk2_s2" type="box" size="1.2 0.18 0.013" pos="0 4.1 0.013" material="crosswalk" contype="0" conaffinity="0"/>
    <geom name="crosswalk2_s3" type="box" size="1.2 0.18 0.013" pos="0 4.9 0.013" material="crosswalk" contype="0" conaffinity="0"/>
    <geom name="crosswalk2_s4" type="box" size="1.2 0.18 0.013" pos="0 5.7 0.013" material="crosswalk" contype="0" conaffinity="0"/>
    <geom name="crosswalk2_s5" type="box" size="1.2 0.18 0.013" pos="0 6.5 0.013" material="crosswalk" contype="0" conaffinity="0"/>

    <!-- crosswalk 3 : x = 15 (차량용) -->
    <geom name="crosswalk3_s1" type="box" size="1.2 0.18 0.013" pos="15 3.3 0.013" material="crosswalk" contype="0" conaffinity="0"/>
    <geom name="crosswalk3_s2" type="box" size="1.2 0.18 0.013" pos="15 4.1 0.013" material="crosswalk" contype="0" conaffinity="0"/>
    <geom name="crosswalk3_s3" type="box" size="1.2 0.18 0.013" pos="15 4.9 0.013" material="crosswalk" contype="0" conaffinity="0"/>
    <geom name="crosswalk3_s4" type="box" size="1.2 0.18 0.013" pos="15 5.7 0.013" material="crosswalk" contype="0" conaffinity="0"/>
    <geom name="crosswalk3_s5" type="box" size="1.2 0.18 0.013" pos="15 6.5 0.013" material="crosswalk" contype="0" conaffinity="0"/>

    <!-- =========================
         신호등 (중앙 횡단보도 기준)
         ========================= -->
    <!-- 아래쪽 -->
    <body name="traffic_light_bottom" pos="1.8 2.0 0">
      <geom name="pole_bottom" type="cylinder" size="0.08 1.2" pos="0 0 1.2" material="pole"/>
      <geom name="red_light_bottom" type="sphere" size="0.12" pos="0 0 2.25" material="light_red" contype="0" conaffinity="0"/>
      <geom name="green_light_bottom" type="sphere" size="0.12" pos="0 0 1.95" material="light_green" contype="0" conaffinity="0"/>
    </body>

    <!-- 위쪽 -->
    <body name="traffic_light_top" pos="-1.8 8.0 0">
      <geom name="pole_top" type="cylinder" size="0.08 1.2" pos="0 0 1.2" material="pole"/>
      <geom name="red_light_top" type="sphere" size="0.12" pos="0 0 2.25" material="light_red" contype="0" conaffinity="0"/>
      <geom name="green_light_top" type="sphere" size="0.12" pos="0 0 1.95" material="light_green" contype="0" conaffinity="0"/>
    </body>

    <!-- =========================
         자동차
         slide joint로 x축 이동
         ========================= -->
    <!-- 아래 차선: 왼쪽 -> 오른쪽 -->
    <body name="car1" pos="-20 4.1 0.28">
      <joint name="car1_slide" type="slide" axis="1 0 0" limited="false"/>
      <geom name="car1_body" type="box" size="0.9 0.55 0.25" material="car_red"/>
      <geom name="car1_roof" type="box" size="0.45 0.45 0.15" pos="0 0 0.25" material="car_gray"/>
    </body>

    <!-- 위 차선: 오른쪽 -> 왼쪽 -->
    <body name="car2" pos="18 5.9 0.28">
      <joint name="car2_slide" type="slide" axis="-1 0 0" limited="false"/>
      <geom name="car2_body" type="box" size="0.9 0.55 0.25" material="car_blue"/>
      <geom name="car2_roof" type="box" size="0.45 0.45 0.15" pos="0 0 0.25" material="car_gray"/>
    </body>

    <!-- 아래 차선: 추가 차량 -->
    <body name="car3" pos="-5 4.1 0.28">
      <joint name="car3_slide" type="slide" axis="1 0 0" limited="false"/>
      <geom name="car3_body" type="box" size="0.9 0.55 0.25" material="car_gray"/>
      <geom name="car3_roof" type="box" size="0.45 0.45 0.15" pos="0 0 0.25" material="car_blue"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="car1_motor" joint="car1_slide" gear="1"/>
    <motor name="car2_motor" joint="car2_slide" gear="1"/>
    <motor name="car3_motor" joint="car3_slide" gear="1"/>
  </actuator>
</mujoco>