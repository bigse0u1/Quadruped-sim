<mujoco model="spot 50x50 empty map">
  <include file="robots/boston_dynamics_spot/spot_arm.xml"/>

  <compiler meshdir="robots/boston_dynamics_spot/assets"/>

  <statistic center="0 0 0.5" extent="30" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.4 0.4 0.4" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="220" elevation="-20"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <!-- 하늘 배경 -->
    <texture 
      type="skybox" 
      builtin="gradient" 
      rgb1="0.3 0.5 0.7" 
      rgb2="0 0 0" 
      width="512" 
      height="3072"/>

    <!-- 흰색 바닥 -->
    <material name="white_floor" rgba="1 1 1 1"/>

    <!-- 벽 재질 -->
    <material name="wall" rgba="0.75 0.75 0.7 1"/>
  </asset>

  <worldbody>
    <!-- 
      50m x 50m 흰색 바닥
      중심: (0, 0)
      x 범위: -25 ~ 25
      y 범위: -25 ~ 25
    -->
    <geom 
      name="floor" 
      type="box" 
      size="25 25 0.025" 
      pos="0 0 -0.025" 
      material="white_floor"/>

    <!-- 위쪽 벽: y = 25 -->
    <geom 
      name="wall_y_pos" 
      type="box" 
      size="25 0.1 0.75" 
      pos="0 25 0.75" 
      material="wall"/>

    <!-- 아래쪽 벽: y = -25 -->
    <geom 
      name="wall_y_neg" 
      type="box" 
      size="25 0.1 0.75" 
      pos="0 -25 0.75" 
      material="wall"/>

    <!-- 오른쪽 벽: x = 25 -->
    <geom 
      name="wall_x_pos" 
      type="box" 
      size="0.1 25 0.75" 
      pos="25 0 0.75" 
      material="wall"/>

    <!-- 왼쪽 벽: x = -25 -->
    <geom 
      name="wall_x_neg" 
      type="box" 
      size="0.1 25 0.75" 
      pos="-25 0 0.75" 
      material="wall"/>
  </worldbody>
</mujoco>