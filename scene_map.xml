<mujoco model="spot 50x50 custom map">
  <include file="robots/boston_dynamics_spot/spot_arm.xml"/>

  <compiler meshdir="robots/boston_dynamics_spot/assets"/>

  <statistic center="0 0 0.5" extent="30" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.4 0.4 0.4" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="220" elevation="-20"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <!-- 하늘 배경 -->
    <texture 
      type="skybox" 
      builtin="gradient" 
      rgb1="0.3 0.5 0.7" 
      rgb2="0 0 0" 
      width="512" 
      height="3072"/>

    <!-- 기본 바닥 / 벽 -->
    <material name="white_floor" rgba="1 1 1 1"/>
    <material name="wall" rgba="0.75 0.75 0.70 1"/>

    <!-- 맵 오브젝트 재질 -->
    <material name="water" rgba="0.62 0.75 0.90 1"/>
    <material name="building" rgba="0.72 0.72 0.72 1"/>
    <material name="green_area" rgba="0.40 0.65 0.24 1"/>
    <material name="red_mark" rgba="1 0.15 0.05 1"/>
  </asset>

  <worldbody>
    <!-- 기본 바닥 -->
    <geom 
      name="floor" 
      type="box" 
      size="25 25 0.025" 
      pos="0 0 -0.025" 
      material="white_floor"/>

    <!-- 외곽 벽 -->
    <geom 
      name="wall_y_pos" 
      type="box" 
      size="25 0.1 0.75" 
      pos="0 25 0.75" 
      material="wall"/>

    <geom 
      name="wall_y_neg" 
      type="box" 
      size="25 0.1 0.75" 
      pos="0 -25 0.75" 
      material="wall"/>

    <geom 
      name="wall_x_pos" 
      type="box" 
      size="0.1 25 0.75" 
      pos="25 0 0.75" 
      material="wall"/>

    <geom 
      name="wall_x_neg" 
      type="box" 
      size="0.1 25 0.75" 
      pos="-25 0 0.75" 
      material="wall"/>

    <!-- 파란색 물 영역 (-1 의미, 여기서는 시각적으로만 표시) -->
    <!-- contype=0, conaffinity=0 : 충돌 없음 -->
    <geom name="water_01" type="box"
          size="2.5 2.5 0.02"
          pos="-22.5 7.5 0.02"
          material="water"
          contype="0" conaffinity="0"/>

    <geom name="water_02" type="box"
          size="6.5 2.5 0.02"
          pos="-9.5 7.5 0.02"
          material="water"
          contype="0" conaffinity="0"/>

    <geom name="water_03" type="box"
          size="8 2.5 0.02"
          pos="9 7.5 0.02"
          material="water"
          contype="0" conaffinity="0"/>

    <geom name="water_04" type="box"
          size="2 2.5 0.02"
          pos="23 7.5 0.02"
          material="water"
          contype="0" conaffinity="0"/>

    <!-- 회색 건물 영역 (+6~8, 여기서는 높이 7m로 통일) -->
    <!-- 높이 7m => size z = 3.5, pos z = 3.5 -->

    <!-- 좌상단 중간 건물 -->
    <geom name="building_01" type="box"
          size="4.5 2.5 3.5"
          pos="-17.5 15.5 3.5"
          material="building"/>

    <!-- 상단 세로 건물 -->
    <geom name="building_02" type="box"
          size="2.5 5.5 3.5"
          pos="-6.5 18.5 3.5"
          material="building"/>

    <!-- 우상단 ㄱ자 건물 - 가로 -->
    <geom name="building_03a" type="box"
          size="5.5 3 3.5"
          pos="16.5 21 3.5"
          material="building"/>

    <!-- 우상단 ㄱ자 건물 - 세로 -->
    <geom name="building_03b" type="box"
          size="2.5 4.5 3.5"
          pos="19.5 14.5 3.5"
          material="building"/>

    <!-- 좌하단 큰 건물 - 세로 -->
    <geom name="building_04a" type="box"
          size="3.5 6.5 3.5"
          pos="-18.5 -3.5 3.5"
          material="building"/>

    <!-- 좌하단 큰 건물 - 가로 아래 돌출 -->
    <geom name="building_04b" type="box"
          size="2 1.5 3.5"
          pos="-13.0 -9.5 3.5"
          material="building"/>

    <!-- 중앙 아래 건물 -->
    <geom name="building_05" type="box"
          size="5 3 3.5"
          pos="0 -7 3.5"
          material="building"/>

    <!-- 우중앙 세로 건물 -->
    <geom name="building_06a" type="box"
          size="2 4.5 3.5"
          pos="15 0.5 3.5"
          material="building"/>

    <!-- 우중앙 가로 건물 -->
    <geom name="building_06b" type="box"
          size="4 2 3.5"
          pos="12 -2 3.5"
          material="building"/>

    <!-- 하단 중앙 세로 건물 -->
    <geom name="building_07" type="box"
          size="2.5 4.5 3.5"
          pos="-6.5 -16.5 3.5"
          material="building"/>

    <!-- 초록색 영역 (+1) -->
    <!-- 높이 1m => size z = 0.5, pos z = 0.5 -->
    <geom name="green_01" type="box"
          size="2 1 0.15"
          pos="-22 23 0.15"
          material="green_area"/>

    <geom name="green_02" type="box"
          size="1 2 0.15"
          pos="14 13 0.15"
          material="green_area"/>

    <geom name="green_03" type="box"
          size="1 2 0.15"
          pos="-11 -2 0.15"
          material="green_area"/>

    <!-- 빨간색 표시: 색칠만 하는 마커 -->
    <!-- 충돌 없음 / 매우 얇음 -->
    <geom name="red_mark_01" type="box"
          size="1 1 0.03"
          pos="0 23 0.03"
          material="red_mark"
          contype="0" conaffinity="0"/>

    <geom name="red_mark_02" type="box"
          size="1 1 0.03"
          pos="0 -19 0.03"
          material="red_mark"
          contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>